diff --git a/.github/workflows/deploy-admin.yml b/.github/workflows/deploy-admin.yml
index 4c98582..2593611 100644
--- a/.github/workflows/deploy-admin.yml
+++ b/.github/workflows/deploy-admin.yml
@@ -45,9 +45,10 @@ jobs:
         working-directory: cathy/worker
         env:
           ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
+          OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
           CATHY_GITHUB_TOKEN: ${{ secrets.CATHY_GITHUB_TOKEN }}
         run: |
-          jq -n 'env | {ANTHROPIC_API_KEY, CATHY_GITHUB_TOKEN} | with_entries(select(.value != null and .value != ""))' > secrets.json
