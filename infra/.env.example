# Credentials for running Terraform locally. Copy, fill in, lock down:
#
#   cp infra/.env.example infra/.env && chmod 600 infra/.env
#
# Load into the current shell before running terraform (from the repo root):
#
#   set -a; source infra/.env; set +a
#
# infra/.env is git-ignored. Never commit it, paste it anywhere, or let a tool print it.
# Non-secret settings (account id, org id, emails, db_host) go in backend.hcl and terraform.tfvars instead.

# Cloudflare API token (My Profile → API Tokens → Create Custom Token). Permissions:
#   Account: Access: Apps and Policies Edit; Access: Organizations, Identity Providers, and Groups Edit;
#            Hyperdrive Edit; Workers Scripts Edit
#   Zone (withchris.uk only): Zone Read; DNS Edit; Workers Routes Edit
CLOUDFLARE_API_TOKEN=

# Supabase personal access token (supabase.com → Account → Access Tokens), in the withchris org.
SUPABASE_ACCESS_TOKEN=

# R2 token for Terraform's state (R2 → Manage API tokens → Object Read & Write, bucket withchris-tfstate only).
# The S3 backend reads these names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Passwords for the Supabase projects. Generate each with: openssl rand -hex 24
# database_password: the new project's postgres superuser. Only used when the project is created.
TF_VAR_database_password=
# admin_worker_password: the admin Worker's database login, stored in the Hyperdrive config.
# Also set on the role by hand once (admin/README.md → Setting the worker's password).
TF_VAR_admin_worker_password=
