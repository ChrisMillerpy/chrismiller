// The Cathy Worker: session registry (D1), one Session per chat, one Sandbox (container) per chat.
// Private: no workers.dev address; admin reaches it through a service binding.
// Deployed by .github/workflows/deploy-cathy.yml (which also makes a "-preview" copy for testing).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "withchris-cathy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Lets the Worker import d1/migrations/*.sql as text.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "MODEL": "claude-opus-5-5",
    // Not secret. Needed because the Anthropic API key isn't tied to one workspace.
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_01FmUYHR2hN27aVWV94E2fxV"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "withchris-registry" }],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" },
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  "containers": [
    {
      "name": "sandbox",
      "scheduling_policy": "durable_object",
      "images": { "workspace": { "dockerfile": "../sandbox/Dockerfile" } }
    }
  ],
  "exports": {
    "Session": { "type": "durable-object", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "storage": "sqlite", "container": "sandbox" }
  },
  "observability": { "enabled": true }
}
