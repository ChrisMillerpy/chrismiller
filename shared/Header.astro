---
import { SITE, URLS } from './site';

// Each link is a different site, so "current" means this page is on that site.
const here = Astro.site?.origin;
const links = [
  { href: URLS.learn, label: 'Tuition' },
  { href: URLS.blog, label: 'Blog' },
];
---

<header>
  <a class="brand" href={URLS.home}>{SITE.name}</a>
  <nav>
    {links.map(({ href, label }) => (
      <a href={href} aria-current={new URL(href).origin === here ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>

<style>
  header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 22px; }
  .brand { font-family: var(--display); font-weight: 600; font-size: 21px; color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 22px; font-size: 15px; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a[aria-current] { color: var(--ink); font-weight: 600; }
</style>
