---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

// Drop a photo at src/assets/me.jpg (or .png/.webp) and it appears in the About section.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/me.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;

const mailto = `mailto:${SITE.email}?subject=${encodeURIComponent('Tuition enquiry')}`;

const levels = [
  { name: 'GCSE Maths', detail: 'Years 10–11 · Foundation and Higher, all exam boards' },
  { name: 'A-level Maths and Further Maths', detail: 'Years 12–13 · AQA, Edexcel, OCR, OCR MEI' },
  { name: 'Admissions tests', detail: 'MAT, TMUA and STEP for Oxford, Cambridge, Imperial, Warwick and others' },
];
---

<Base
  title="Maths tuition"
  description="One-to-one maths tuition for GCSE, A-level, Further Maths and admissions tests (MAT, TMUA, STEP). Online, or in person in central and south London."
  background="paper"
>
  <div class="hero-bg" slot="before" aria-hidden="true"></div>

  <main class="wrap">
    <div class="hero">
      <div>
        <p class="eyebrow">Maths tuition · London and online</p>
        <h1>Maths lessons for students who are <em>stuck</em>, and students who want <em>more</em></h1>
        <p class="lede">
          One-to-one tuition for GCSE, A-level and Further Maths, and preparation for the MAT, TMUA and STEP.
          Online, or in person in central and south London.
        </p>
        <div class="ctas">
          <a class="btn" href={mailto}>Email to check availability</a>
          <span class="addr">{SITE.email}</span>
        </div>
        <p class="pen">
          <svg width="40" height="30" viewBox="0 0 40 30" aria-hidden="true"><path d="M36 28 C30 14, 18 6, 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /><path d="M12 1 L5 6 L12 11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          free chat first, and the first lesson is on me
        </p>
      </div>
      <div class="card">
        <h2>What I teach</h2>
        <ul>
          {levels.map((l) => (
            <li><div><b>{l.name}</b><small>{l.detail}</small></div></li>
          ))}
        </ul>
      </div>
    </div>

    <section class="intro">
      <h2 class="big">Every student needs something different</h2>
      <div class="duo">
        <div>
          <span class="tag">finding it hard?</span>
          <h3>We find where it went wrong</h3>
          <p>Usually there's one step, sometimes years back, that never quite landed. We go back to it, rebuild slowly, and practise until the method feels like yours.</p>
        </div>
        <div>
          <span class="tag">finding it easy?</span>
          <h3>We go past the syllabus</h3>
          <p>Proof, problem solving, olympiad questions and admissions-test papers. The maths school doesn't have time for, and the kind universities look for.</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="big steps-title">How we start</h2>
      <div class="steps">
        <div class="step"><span class="n">1</span><div><h3>Free 20-minute consultation</h3><p>A video call with the student and/or a parent or guardian. A parent or guardian needs to join if the student is under 18.</p></div></div>
        <div class="step"><span class="n">2</span><div><h3>First lesson free</h3><p>A full lesson, so you can see how I teach before committing to anything.</p></div></div>
      </div>
      <p class="after">…then we carry on in whatever way works for you.</p>
    </section>

    <section class:list={['about', { 'no-photo': !photo }]}>
      {photo && <Image class="photo" src={photo} alt="Chris Miller" width={480} />}
      <div>
        <h2 class="big">About me</h2>
        <p>I've loved teaching maths for as long as I can remember. At school I was the one explaining the lesson to friends afterwards, and since then I've tutored many students through GCSE and A-level.</p>
        <p>After university I worked at a startup at the meeting point of education and AI, building tools that help teachers and students get more out of their lessons.</p>
        <ul class="creds">
          <li>
            <div><b>BSc Mathematical Sciences</b><span>Durham University · mainly pure maths, with statistics and mathematical physics. Dissertation on the mathematics of quantum physics.</span></div>
            <em>top of the year</em>
          </li>
          <li>
            <div><b>MPhil in Data Intensive Science</b><span>University of Cambridge, Department of Physics · dissertation on computer vision models that detect cancer in CT scans.</span></div>
            <em>Distinction</em>
          </li>
        </ul>
      </div>
    </section>

    <div class="closing">
      <div>
        <h2>Check availability</h2>
        <p>Tell me the level, the exam board, and what's going on. I'll reply within a couple of days.</p>
      </div>
      <a class="btn" href={mailto}>Email {SITE.email}</a>
    </div>
  </main>
</Base>

<style>
  /* Graph paper behind the top of the page only, fading out. */
  .hero-bg {
    position: absolute; inset: 0 0 auto 0; height: 760px; z-index: -1; pointer-events: none;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, #000 50%, transparent);
  }
  :global(body) { position: relative; isolation: isolate; }

  .hero { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 56px; align-items: center; padding-block: 40px 96px; }
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--cobalt); margin: 0 0 14px; }
  h1 { font-size: clamp(36px, 5.4vw, 58px); letter-spacing: -.01em; }
  h1 em { color: var(--cobalt); }
  .lede { font-size: 19px; color: var(--muted); max-width: 50ch; margin: 22px 0 30px; }
  .ctas { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .btn { display: inline-block; background: var(--cobalt); color: #fff; text-decoration: none; font-weight: 600; padding: 15px 24px; border-radius: 8px; box-shadow: 0 2px 0 #1A2F95; }
  .btn:hover { background: var(--cobalt-hover); }
  .addr { font-size: 15px; color: var(--muted); user-select: all; }
  .pen { font-family: var(--hand); color: var(--pen); font-size: 21px; line-height: 1.2; display: flex; align-items: flex-end; gap: 6px; margin-top: 18px; }
  .pen svg { flex: none; }

  .card { background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 26px 28px; box-shadow: 0 18px 40px -26px rgba(24, 32, 58, .45); transform: rotate(1.2deg); }
  .card h2 { font: 600 15px var(--ui); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .card ul { list-style: none; margin: 0; padding: 0; }
  .card li { display: grid; grid-template-columns: 26px 1fr; gap: 8px; padding-block: 12px; border-top: 1px dashed var(--line); }
  .card li:first-child { border-top: 0; }
  .card li::before { content: '✓'; font-family: var(--hand); font-weight: 700; color: var(--pen); font-size: 20px; line-height: 1.2; }
  .card b { font-family: var(--display); font-weight: 600; font-size: 19px; display: block; }
  .card small { color: var(--muted); font-size: 14.5px; }

  section { padding-block: 72px; border-top: 1px solid var(--line); }
  .big { font-size: clamp(28px, 3.4vw, 38px); }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 48px; }
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 36px; }
  .duo h3 { font-size: 22px; margin-bottom: 8px; }
  .duo p { margin: 0; color: var(--muted); }
  .tag { font-family: var(--hand); color: var(--pen); font-size: 19px; display: block; margin-bottom: 2px; }

  .steps-title { margin-bottom: 28px; }
  .steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .step { background: var(--cobalt-soft); border-radius: 12px; padding: 26px 28px; display: grid; grid-template-columns: auto 1fr; gap: 18px; align-items: start; }
  .step .n { font-family: var(--display); font-weight: 600; font-size: 40px; line-height: 1; color: var(--cobalt); }
  .step h3 { font-size: 21px; margin-bottom: 6px; }
  .step p { margin: 0; }
  .after { font-family: var(--hand); color: var(--pen); font-size: 21px; margin: 22px 0 0; }

  .about { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 48px; align-items: start; }
  .about.no-photo { grid-template-columns: minmax(0, 1fr); }
  .about :global(.photo) { width: 100%; height: auto; border-radius: 4px; transform: rotate(-1.5deg); box-shadow: 0 14px 30px -22px rgba(24, 32, 58, .5); }
  .about p { max-width: 62ch; margin: 14px 0 0; }
  .creds { list-style: none; margin: 26px 0 0; padding: 0; max-width: 760px; }
  .creds li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; padding-block: 14px; border-top: 1px solid var(--line); align-items: baseline; }
  .creds b { font-family: var(--display); font-weight: 600; font-size: 18px; }
  .creds span { display: block; color: var(--muted); font-size: 15px; }
  .creds em { font-family: var(--hand); font-style: normal; color: var(--pen); font-size: 18px; white-space: nowrap; }

  .closing {
    background: var(--cobalt); color: #fff; border-radius: 16px; padding: 52px 48px; margin-block: 24px 48px;
    display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap;
    background-image: linear-gradient(rgba(255, 255, 255, .07) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .07) 1px, transparent 1px);
    background-size: 28px 28px;
  }
  .closing h2 { color: #fff; font-size: clamp(28px, 3.4vw, 38px); }
  .closing p { margin: 8px 0 0; opacity: .88; }
  .closing .btn { background: #fff; color: var(--cobalt); box-shadow: none; }

  @media (max-width: 820px) {
    .hero, .intro, .duo, .steps, .about { grid-template-columns: 1fr; }
    .hero { gap: 40px; padding-block: 20px 64px; }
    .card { transform: none; }
    .about :global(.photo) { max-width: 220px; }
    .closing { padding: 32px 24px; }
  }
</style>
