{
  "name": "withchris-admin",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "astro": "7.3.8",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "types": "wrangler types --strict-vars=false",
    "check": "wrangler types --strict-vars=false && astro check",
    "check:bundle": "astro build && ! grep -rl DEV_EMAIL dist/ && echo \"bundle ok: no dev sign-in\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "wrangler d1 migrations apply withchris-admin --remote",
    "deploy": "npm run db:migrate && astro build && wrangler deploy"
  }
}
