{
  "name": "withchris-admin",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "astro": "7.3.8",
    "jose": "6.2.12",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.64.0",
    "jsonc-parser": "3.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "types": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "deploy": "astro build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging astro build && wrangler deploy",
    "check:bundle": "astro build && ! grep -rl DEV_STAFF_EMAIL dist/ && echo \"bundle ok: no dev sign-in\""
  }
}
