// Private admin Worker, served only at admin.withchris.uk (behind Cloudflare Access).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "withchris-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "routes": [{ "pattern": "admin.withchris.uk", "custom_domain": true }],
  // workers.dev on for now: withchris.uk is still in the old Cloudflare account.
  "workers_dev": true,
  "preview_urls": false,
  // Cloudflare Access (see README): team domain and the withchris-admin app AUD tag. Both empty = password login, as for previews.
  // Set one without the other and admin refuses everything. Not secrets.
  "vars": { "ACCESS_TEAM_DOMAIN": "withchris-team.cloudflareaccess.com", "ACCESS_AUD": "2721fe935c2544034fcf2515a5204be2af22456d6b49e842e3bf73cf26dfef20" },
  // Lets src/layout.ts import shared/theme.css as text.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  // The Cathy Worker (cathy/worker), reached privately. Admin forwards /api/cathy/* to it.
  "services": [{ "binding": "CATHY", "service": "withchris-cathy" }],
  // Evidence packs (packs/), served at /packs/ behind the same login as the rest of admin.
  "assets": { "directory": "../packs", "binding": "PACKS", "run_worker_first": true }
}
