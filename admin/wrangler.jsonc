// Private admin Worker, served only at admin.withchris.uk (behind Cloudflare Access).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "withchris-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "routes": [{ "pattern": "admin.withchris.uk", "custom_domain": true }],
  // workers.dev on for now: withchris.uk is still in the old Cloudflare account.
  "workers_dev": true,
  "preview_urls": false,
  // Lets src/index.js import shared/theme.css as text.
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }]
}
