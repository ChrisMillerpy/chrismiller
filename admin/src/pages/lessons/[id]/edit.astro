---
import Admin from '../../../layouts/Admin.astro';
import LessonForm from '../../../components/LessonForm.astro';
import { lessonToValues } from '../../../lib/forms';
import { need, notFound, parseId, seeOther } from '../../../lib/http';
import { deleteLesson, getLesson, studentOptions, updateLesson } from '../../../lib/repo';
import { parseLessonForm } from '../../../lib/validate';

const { staff, db } = Astro.locals;
const denied = need(staff, 'finance.write');
if (denied) return denied;

const id = parseId(Astro.params.id);
const lesson = id && (await db((tx) => getLesson(tx, id)));
if (!id || !lesson) return notFound('That lesson');

let errors: Record<string, string> = {};
let values = lessonToValues(lesson);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'delete') {
    await db((tx) => deleteLesson(tx, id));
    return seeOther(`/students/${lesson.student_id}`, 'lesson-deleted');
  }
  const parsed = parseLessonForm(form);
  if (parsed.ok) {
    await db((tx) => updateLesson(tx, id, parsed.value));
    return seeOther(`/students/${parsed.value.student_id}`, 'lesson-saved');
  }
  ({ values, errors } = parsed);
  Astro.response.status = 422;
}

const students = await db((tx) => studentOptions(tx));
---

<Admin title="Edit lesson">
  <h1>Edit lesson</h1>
  <p class="muted">{lesson.student_name}, {lesson.date}</p>
  <LessonForm values={values} errors={errors} students={students} submit="Save" cancel={`/students/${lesson.student_id}`} />

  <section class="danger-zone">
    <form method="post" id="delete-lesson">
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="danger">Delete lesson</button>
    </form>
  </section>
  <script is:inline>
    document.getElementById('delete-lesson')?.addEventListener('submit', (e) => {
      if (!confirm('Delete this lesson?')) e.preventDefault();
    });
  </script>
</Admin>
