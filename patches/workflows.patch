# Workflow changes for the agent-manager PR. Cathy's token can't edit .github/workflows/, so Chris applies this:
#   git apply patches/workflows.patch && git rm -q patches/workflows.patch && git commit -am 'Deploy R2 and share' && git push
# Adds: R2 bucket creation, share Worker deploy and smoke check (production and previews); preview teardown empties and deletes the R2 bucket and share Worker.
diff --git a/.github/workflows/deploy-admin.yml b/.github/workflows/deploy-admin.yml
index 4c98582..3eae153 100644
--- a/.github/workflows/deploy-admin.yml
+++ b/.github/workflows/deploy-admin.yml
@@ -1,13 +1,13 @@
-# Deploys Cathy (cathy/worker + its sandbox) and then admin to production on pushes to main.
-# Admin reaches Cathy through a service binding, so Cathy goes first.
-# Posts commit statuses ("cathy-deploy", "admin-deploy") and a comment with log tails,
+# Deploys Cathy (cathy/worker + its sandbox), then share, then admin to production on pushes to main.
+# Admin and share reach Cathy through service bindings, so Cathy goes first.
+# Posts commit statuses ("cathy-deploy", "share-deploy", "admin-deploy") and a comment with log tails,
 # so results are readable without the Actions logs.
 name: Deploy admin and Cathy
 
 on:
   push:
     branches: [main]
-    paths: ['admin/**', 'cathy/**', 'shared/**', 'd1/**', 'packs/**', 'package.json', 'package-lock.json', '.github/workflows/deploy-admin.yml']
+    paths: ['admin/**', 'cathy/**', 'share/**', 'shared/**', 'd1/**', 'packs/**', 'package.json', 'package-lock.json', '.github/workflows/deploy-admin.yml']
   workflow_dispatch:
 
 permissions:
@@ -33,6 +33,9 @@ jobs:
       - name: Unit tests
         run: npm test
 
+      - name: File storage (R2 bucket withchris-files; already there after the first run)
+        run: npx wrangler r2 bucket create withchris-files 2>&1 | grep -v -i telemetry | tail -2 || true
+
       - name: Deploy Cathy (builds the sandbox image)
         id: cathy
         working-directory: cathy/worker
@@ -51,6 +54,14 @@ jobs:
           if [ "$(jq length secrets.json)" -gt 0 ]; then npx wrangler secret bulk secrets.json 2>&1 | tail -3; fi
           rm -f secrets.json
 
+      - name: Deploy share (public, read-only links)
+        id: share
+        if: steps.cathy.outcome == 'success'
+        working-directory: share
+        run: |
+          set -o pipefail
+          npx wrangler deploy 2>&1 | tee ../share-deploy.log
+
       - name: Deploy admin
         id: admin
         if: steps.cathy.outcome == 'success'
@@ -69,7 +80,8 @@ jobs:
           sleep 5
           code=$(curl -s -o /dev/null -w '%{http_code}' https://withchris-admin.withchris.workers.dev/ || true)
           api=$(curl -s -o /dev/null -w '%{http_code}' https://withchris-admin.withchris.workers.dev/api/cathy/sessions || true)
-          echo "result=home HTTP $code, Cathy API HTTP $api" >> "$GITHUB_OUTPUT"
+          share=$(curl -s -o /dev/null -w '%{http_code}' https://withchris-share.withchris.workers.dev/a/aaaaaaaaaaaaaaaaaaaa || true)
+          echo "result=home HTTP $code, Cathy API HTTP $api, share (dead link, want 404) HTTP $share" >> "$GITHUB_OUTPUT"
 
       - name: Report
         if: always()
@@ -79,9 +91,11 @@ jobs:
           set +e
           ok() { [ "$1" = success ] && echo success || echo failure; }
           gh api "repos/${{ github.repository }}/statuses/${{ github.sha }}" -f state=$(ok "${{ steps.cathy.outcome }}") -f context=cathy-deploy -f description="cathy: ${{ steps.cathy.outcome }}" >/dev/null
+          gh api "repos/${{ github.repository }}/statuses/${{ github.sha }}" -f state=$(ok "${{ steps.share.outcome }}") -f context=share-deploy -f description="https://withchris-share.withchris.workers.dev | ${{ steps.share.outcome }}" >/dev/null
           gh api "repos/${{ github.repository }}/statuses/${{ github.sha }}" -f state=$(ok "${{ steps.admin.outcome }}") -f context=admin-deploy \
             -f description="https://withchris-admin.withchris.workers.dev | ${{ steps.smoke.outputs.result || steps.admin.outcome }}" >/dev/null
           clean() { sed 's/\x1b\[[0-9;]*m//g' "$1" 2>/dev/null | grep -v -i telemetry | tail -n "$2"; }
           { echo "### Production deploy"; echo "**Cathy (${{ steps.cathy.outcome }})**"; echo '```'; clean cathy-deploy.log 20; echo '```';
+            echo "**Share (${{ steps.share.outcome }})**"; echo '```'; clean share-deploy.log 8; echo '```';
             echo "**Admin (${{ steps.admin.outcome }})** ${{ steps.smoke.outputs.result }}"; echo '```'; clean admin-deploy.log 10; echo '```'; } > report.md
           jq -n --rawfile body report.md '{body: $body}' | gh api "repos/${{ github.repository }}/commits/${{ github.sha }}/comments" --input - >/dev/null
